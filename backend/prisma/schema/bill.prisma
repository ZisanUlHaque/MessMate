model Bill {
  id             String     @id @default(uuid())
  messId         String
  userId         String
  month          Int
  year           Int
  totalMeals     Int        @default(0)
  mealRate       Decimal    @default(0) @db.Decimal(10,2)
  totalBazarShare Decimal   @default(0) @db.Decimal(10,2)
  fixedCostShare Decimal    @default(0) @db.Decimal(10,2)
  totalAmount    Decimal    @default(0) @db.Decimal(10,2)
  paidAmount     Decimal    @default(0) @db.Decimal(10,2)
  dueAmount      Decimal    @default(0) @db.Decimal(10,2)
  status         BillStatus @default(UNPAID)
  generatedAt    DateTime   @default(now())
  mess           Mess       @relation(fields: [messId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       Payment[]
  @@unique([messId, userId, month, year])
  @@index([messId, month, year])
  @@index([userId])
  @@map("bills")
}