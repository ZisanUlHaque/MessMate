model Mess {
  id                String    @id @default(uuid())
  name              String    @db.VarChar(100)
  inviteCode        String    @unique @db.VarChar(6)
  managerId         String
  address           String?   @db.VarChar(200)
  monthlyGasBill    Decimal   @default(0) @db.Decimal(10,2)
  monthlyUtilityBill Decimal  @default(0) @db.Decimal(10,2)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  manager           User      @relation("MessManager", fields: [managerId], references: [id])
  members           MessMember[]
  meals             Meal[]
  bazarEntries      Bazar[]
  bills             Bill[]
  notifications     Notification[]
  @@index([managerId])
  @@map("messes")
}