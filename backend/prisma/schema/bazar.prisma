model Bazar {
  id           String        @id @default(uuid())
  messId       String
  addedBy      String
  date         DateTime      @db.Date
  totalAmount  Decimal       @db.Decimal(10,2)
  category     BazarCategory @default(GROCERY)
  receiptUrl   String?       @db.VarChar(500)
  description  String?       @db.VarChar(500)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  mess         Mess          @relation(fields: [messId], references: [id], onDelete: Cascade)
  addedByUser  User          @relation("BazarAddedBy", fields: [addedBy], references: [id])
  items        BazarItem[]
  @@index([messId, date])
  @@index([category])
  @@map("bazars")
}